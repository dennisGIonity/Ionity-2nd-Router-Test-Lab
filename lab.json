{
  "_about": "Ionity Lab - the one place the lab is defined. No secrets here: WiFi passwords live only in each project's git-ignored secrets.h. Policy 986 AED.",
  "household": {
    "router": "TP-Link EX511 (Afrihost)",
    "router_ip": "192.168.0.1",
    "laptop_nic": "WiFi",
    "band": "2.4 GHz (household phones)",
    "wifi_channel_24": 1,
    "wifi_width_24": "20 MHz",
    "tx_power": "High",
    "wifi_channel_5": 36,
    "rule": "Internet only. No lab boards, no lab DNS, no lab services on this network."
  },
  "lab": {
    "router": "H3C Magic",
    "router_ip": "192.168.124.1",
    "subnet": "192.168.124.0/24",
    "laptop_nic": "Ethernet",
    "laptop_mac": "40:C2:BA:F5:B9:5F",
    "laptop_port": "H3C LAN port (never WAN)",
    "server_ip": "192.168.124.4",
    "band": "5 GHz (main lab network)",
    "wifi_ssid_5": "IONITY-LAB",
    "wifi_channel_5": 149,
    "wifi_ssid": "IONITY-LAB-IOT",
    "wifi_note": "wifi_ssid is what the boards join. ESP32-S3 / Pico 2 W radios are 2.4 GHz only, so the lab keeps one low-power 2.4 GHz network for them.",
    "wifi_channel_24": 11,
    "wifi_width_24": "20 MHz",
    "tx_power_24": "Low",
    "rule": "All boards, the Pi 5 and lab services live here. Isolated from the household."
  },
  "broker": { "bind": "0.0.0.0:1883", "venv": ".venv" },
  "pi": {
    "user": "wabapi",
    "host_alias": "raspberrypi",
    "addresses": ["192.168.124.3", "192.168.0.11", "192.168.0.10"],
    "ssh_key": "~/.ssh/id_ed25519",
    "dashboard_url": "http://ionity-fleet.local:8099/",
    "dashboard_fallback": "http://192.168.124.4:8099/"
  },
  "ports": { "mqtt": 1883, "http": 8099, "dns": 53, "mdns": 5353 },
  "metrics": { "household_nic": 10, "lab_nic": 200 },
  "projects": [
    {
      "name": "ESP32-MCP",
      "repo": "https://github.com/dennisGIonity/Esp32-MCP",
      "path": "E:\\.ESP32-MCP",
      "firmware_dir": "firmware-arduino",
      "env_file": ".env",
      "env": { "IONITY_MDNS_ADVERTISE_IP": "{server_ip}", "IONITY_DNS_BIND": "{server_ip}" },
      "start": "scripts\\start_lab.ps1",
      "health_url": "http://127.0.0.1:8099/api/v1/health",
      "devices_url": "http://127.0.0.1:8099/api/v1/devices?limit=500"
    }
  ]
}
